{
  "name": "vue-service-bay",
  "version": "0.3.1",
  "description": "Your One-Stop Solution for Vue.js Refactoring",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyle-io/vue-service-bay.git",
    "directory": "packages/vue-service-bay"
  },
  "main": "./dist/index.js",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsc -d -w",
    "build": "tsc -d",
    "type:check": "tsc --noEmit",
    "format:check": "prettier --cache --check \"./src/**/*.{js,ts,vue,json}\"",
    "format:fix": "prettier --cache --write \"./src/**/*.{js,ts,vue,json}\"",
    "publish:check": "publint",
    "test:watch": "vitest",
    "check:all": "pnpm type:check && pnpm format:check && pnpm publish:check"
  },
  "keywords": [
    "vue",
    "vue3",
    "ast",
    "static analysis",
    "code generation",
    "code refactor"
  ],
  "author": "baseballyama",
  "license": "MIT",
  "devDependencies": {
    "publint": "0.3.25",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@babel/types": "8.0.6",
    "dom-serializer": "3.1.1",
    "domhandler": "6.0.1",
    "htmlparser2": "12.0.0",
    "magic-string": "1.4.3",
    "postcss": "8.5.29",
    "postcss-scss": "4.0.9",
    "recast": "0.24.0",
    "tinyglobby": "0.2.17",
    "zimmerframe": "1.1.5"
  }
}
